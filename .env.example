# Vercel supplies infrastructure values; use a separate development database/store.
CUE_PORT=5303
CUE_ORIGIN=http://127.0.0.1:5303
DATABASE_URL=
# Base64 PEM from your database provider; certificate verification stays enabled.
DATABASE_CA_BASE64=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate independent random 32-byte secrets. Never prefix these with NEXT_PUBLIC_.
CUE_MASTER_KEY=
CUE_SIGNING_SECRET=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
# Exact public Git commit used by the isolated renderer (set per release).
CUE_RENDER_REF=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_PLANNER_MODEL=gpt-5.4-mini
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-6
# Optional default voice selection, not a provider API key.
ELEVENLABS_VOICE_ID=
# Provider API keys belong to users and are added through authenticated Settings.
# Explicit offline adapter for unit/CLI development ONLY; never set on Vercel.
# CUE_LOCAL_DATABASE=1

# Must match development / preview / production. The DB also stores its environment tag.
CUE_DATA_ENVIRONMENT=development
# Use local disk only with a dedicated local/development database.
CUE_STORAGE=local
# When sharing Supabase identity ONLY for sign-in, block all account mutations.
CUE_SHARED_AUTH_READ_ONLY=1
# Set to 1 only after SMTP, confirmations and password recovery have been verified.
CUE_PUBLIC_SIGNUP=0
CUE_MAX_CONCURRENT_JOBS=6

# Reservations plus estimated charges in the last 24h. Unresolved reservations remain counted.
CUE_ACCOUNT_DAILY_CENTS=5000
CUE_GLOBAL_DAILY_CENTS=20000
