{
  "name": "cue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <27"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev apps/editor --hostname 127.0.0.1 --port 5303",
    "worker": "tsx apps/worker/main.ts",
    "build": "npm run extension:build && next build apps/editor",
    "start": "tsx scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/smoke.ts",
    "extension:build": "tsx scripts/package-extension.ts",
    "seed": "tsx scripts/seed.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write apps packages scripts tests docs *.json *.ts README.md",
    "format:check": "prettier --check apps packages scripts tests docs *.json *.ts README.md"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@remotion/bundler": "4.0.527",
    "@remotion/player": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "archiver": "8.0.0",
    "motion": "13.4.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.527",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
