{
  "manifest_version": 3,
  "name": "Cue Capture",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Capture your website's real screens and interactions for Cue product films. Your login stays in this tab.",
  "permissions": [
    "activeTab",
    "debugger",
    "sidePanel",
    "storage",
    "webNavigation",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Capture with Cue" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "128": "icon.png" }
}
